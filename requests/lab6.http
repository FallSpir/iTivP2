@base = http://localhost:3000
@token = PASTE_TOKEN_HERE
@mongoId = PASTE_MONGO_ID_HERE

POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "admin@dashboard.com",
  "password": "admin123"
}

###

POST {{base}}/mongo/metrics
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Выручка",
  "value": 125000,
  "unit": "BYN",
  "category": "finance",
  "trend": 5.2,
  "tags": ["ключевая", "квартал-3"]
}

###

GET {{base}}/mongo/metrics
Authorization: Bearer {{token}}

###

PUT {{base}}/mongo/metrics/{{mongoId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Выручка Q3",
  "value": 132000,
  "unit": "BYN",
  "category": "finance",
  "trend": 6.5,
  "tags": ["ключевая", "квартал-3", "обновлено"]
}

###

### Доп: добавить точку в историю значений
POST {{base}}/mongo/metrics/{{mongoId}}/history
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "value": 128000,
  "date": "2026-08-01T00:00:00.000Z"
}

###

### Доп: добавить тег
POST {{base}}/mongo/metrics/{{mongoId}}/tags
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "tag": "приоритет"
}

###

DELETE {{base}}/mongo/metrics/{{mongoId}}
Authorization: Bearer {{token}}
