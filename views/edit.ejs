<%- include('partials/header') %>

<div class="breadcrumb">
  <a href="/item/<%= metric.id %><%= authSuffix %>">← Назад</a>
</div>

<div class="form-card">
  <h1>Редактировать метрику</h1>

  <% if (error) { %>
    <div class="form-error"><%= error %></div>
  <% } %>

  <form action="/edit/<%= metric.id %>?auth=1" method="POST" class="metric-form">
    <div class="form-group">
      <label for="name">Название</label>
      <input type="text" id="name" name="name"
        value="<%= fields ? fields.name : metric.name %>"
        maxlength="10" pattern=".{1,10}" title="Введите от 1 до 10 символов" required />
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="value">Значение</label>
        <input type="number" id="value" name="value"
          value="<%= fields ? fields.value : metric.value %>"
          step="any" min="0" max="999999" required />
      </div>
      <div class="form-group">
        <label for="unit">Единица</label>
        <input type="text" id="unit" name="unit"
          value="<%= fields ? fields.unit : metric.unit %>"
          maxlength="10" pattern="[A-Za-zА-Яа-яЁё%]{1,10}" title="Только буквы и %, не более 10 символов" required />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="category">Категория</label>
        <select id="category" name="category" required>
          <option value="">Выберите категорию</option>
          <% ['Finance','Marketing','Sales','Operations','HR'].forEach(cat => { %>
            <option value="<%= cat %>" <%= (fields ? fields.category : metric.category) === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="trend">Тренд (%)</label>
        <input type="number" id="trend" name="trend"
          value="<%= fields ? fields.trend : metric.trend %>"
          step="any" min="-9999" max="9999" />
      </div>
    </div>

    <div class="form-actions">
      <a href="/item/<%= metric.id %><%= authSuffix %>" class="btn btn-secondary">Отмена</a>
      <button type="submit" class="btn btn-primary">Сохранить</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
